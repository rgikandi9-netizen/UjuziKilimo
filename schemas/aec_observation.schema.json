{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aec.local/schemas/aec_observation.schema.json",
  "title": "AEC Observation",
  "type": "object",
  "required": [
    "node_id",
    "observation_id",
    "observer_name",
    "observed_at_iso",
    "gps_latitude",
    "gps_longitude",
    "photo_reference",
    "timestamp_confirmed",
    "soil_moisture_vwc_10cm",
    "soil_moisture_vwc_30cm",
    "surface_temp_c",
    "subsurface_temp_c",
    "mulch_depth_cm",
    "biomass_dry_matter_g",
    "decomposition_mass_loss_pct",
    "canopy_vigour_score",
    "pest_disease_pressure_score",
    "ridge_structural_integrity"
  ],
  "properties": {
    "node_id": { "type": "string", "minLength": 1 },
    "observation_id": { "type": "string", "minLength": 1 },
    "observer_name": { "type": "string", "minLength": 1 },
    "observed_at_iso": { "type": "string", "format": "date-time" },
    "gps_latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "gps_longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "gps_accuracy_m": { "type": ["number", "null"], "minimum": 0 },
    "photo_reference": { "type": "string", "minLength": 1 },
    "timestamp_confirmed": { "type": "boolean" },
    "soil_moisture_vwc_10cm": { "type": "number", "minimum": 0, "maximum": 100 },
    "soil_moisture_vwc_30cm": { "type": "number", "minimum": 0, "maximum": 100 },
    "surface_temp_c": { "type": "number", "minimum": -20, "maximum": 80 },
    "subsurface_temp_c": { "type": "number", "minimum": -20, "maximum": 80 },
    "mulch_depth_cm": { "type": "number", "minimum": 0 },
    "biomass_dry_matter_g": { "type": "number", "minimum": 0 },
    "decomposition_mass_loss_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "canopy_vigour_score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "pest_disease_pressure_score": { "type": "integer", "minimum": 0, "maximum": 3 },
    "ridge_structural_integrity": { "type": "string", "enum": ["Intact", "Minor", "Compromised"] },
    "notes": { "type": "string" }
  }
}
